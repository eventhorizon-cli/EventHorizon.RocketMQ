{
  "RocketMQ": {
    "Client": {
      "Endpoint": "localhost:8081",
      "RequestTimeout": "00:00:03",
      "UseTLS": false
    },
    "Consumer": {
      "GroupName": "rocketmq-dotnet-grpc-lite-push-sample",
      "BindTopic": "rocketmq-dotnet-lite-manual",
      "LiteTopics": [
        "rocketmq-dotnet-lite-sample"
      ],
      "BatchSize": 16,
      "MaxConcurrency": 4,
      "MaxDeliveryAttempts": 16,
      "InvisibleDuration": "00:00:30",
      "LongPollingTimeout": "00:00:15",
      "SubscriptionSyncInterval": "00:00:30"
    }
  }
}
