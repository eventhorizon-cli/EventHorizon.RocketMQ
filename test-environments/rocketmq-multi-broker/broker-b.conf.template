brokerClusterName=DefaultCluster
brokerName=broker-b
brokerId=0

# Replaced by the Compose startup command. It must be reachable from the host and Proxy container.
brokerIP1=__ROCKETMQ_ADVERTISED_HOST__
namesrvAddr=nameserver:9876
listenPort=10921

brokerRole=ASYNC_MASTER
flushDiskType=ASYNC_FLUSH
deleteWhen=04
fileReservedTime=24

defaultTopicQueueNums=3
autoCreateTopicEnable=true
autoCreateSubscriptionGroup=true
enablePropertyFilter=true
recallMessageEnable=true

# Lite messages use LMQ multi-dispatch queues.
enableLmq=true
enableMultiDispatch=true
